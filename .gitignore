# ========== Go 服务端 ==========
# 编译产物
/server/psc-server
/server/psc-server.exe
/server/psc-server-*
/server/*.exe
/server/*.exe~
/server/*.dll
/server/*.so
/server/*.dylib

# 测试二进制文件
/server/*.test

# 依赖缓存
/server/vendor/
/server/go.sum   # 如果希望锁定依赖版本，可以删除这一行；通常建议提交 go.sum，这里可选

# 接收的图片目录（运行时生成的）
/server/received_images/

# 临时文件
/server/tmp/
/server/temp/
/server/*.log
/server/logs/

# IDE 配置
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ========== 微信小程序端 ==========
# 小程序开发工具生成的临时文件
/miniprogram/.idea/
/miniprogram/.vscode/
/miniprogram/.DS_Store
/miniprogram/*.log

# 打包产物（如果存在）
/miniprogram/miniprogram_npm/
/miniprogram/node_modules/

# 项目配置文件中的敏感信息（如包含 appid 等，不建议忽略 appid，但可选择性忽略）
# 默认不忽略 project.config.json，因为通常包含 appid
# 如果团队需要各自配置，可取消下面一行注释
# /miniprogram/project.config.json

# 小程序预览/上传临时文件
/miniprogram/.tea/
/miniprogram/.dp/

# ========== 通用忽略 ==========
# 操作系统生成文件
.DS_Store
Thumbs.db
desktop.ini

# 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 环境变量文件
.env
.env.local
.env.*.local

# 备份文件
*.bak
*.orig
*.tmp

# 压缩包
*.zip
*.tar.gz
*.rar

# 文档生成临时文件
*.aux
*.out
*.toc


/server/received_images/

/desktop/received_images/

# Wails bin directory
desktop/build/bin
# Wails Windows NSIS support files
desktop/build/windows/installer/wails_tools.nsh
desktop/build/windows/installer/tmp/

# IDEs
.idea
.vscode

# The black hole that is...
ndesktop/ode_modules
