/* ===== 页面基础 ===== */
page {
  background-color: #F9FAFB;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F9FAFB;
}

/* ===== 状态栏占位 ===== */
.status-bar {
  flex-shrink: 0;
  background: white;
}

/* ===== 顶部导航栏（精简） ===== */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  background: white;
  border-bottom: 1rpx solid #E5E7EB;
  flex-shrink: 0;
  min-height: 88rpx;
}
.nav-back {
  font-size: 48rpx;
  color: #1F2937;
  padding: 8rpx 16rpx 8rpx 4rpx;
  font-weight: 300;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1F2937;
  margin-left: 12rpx;
}

/* ===== 缩略图网格 ===== */
.grid-scroll {
  flex: 1;
  padding: 20rpx 20rpx 0;
  overflow-y: auto;
}
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding-bottom: 20rpx;
}
.grid-item {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: #E5E7EB;
}
.grid-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.grid-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
}
.grid-remove:active {
  opacity: 0.6;
}
.grid-index {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  background: rgba(0,0,0,0.5);
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}
.add-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F3F4F6;
  border: 2rpx dashed #D1D5DB;
  aspect-ratio: 1 / 1;
  border-radius: 16rpx;
}
.add-more:active {
  background: #E5E7EB;
}
.add-icon {
  font-size: 48rpx;
  color: #9CA3AF;
}
.add-text {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

/* ===== 底部设置区 ===== */
.settings-area {
  background: white;
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E5E7EB;
  flex-shrink: 0;
}
.setting-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}
.setting-row:last-child {
  border-bottom: none;
}
.setting-label {
  font-size: 28rpx;
  color: #1F2937;
  width: 150rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.setting-input {
  flex: 1;
  font-size: 28rpx;
  color: #1F2937;
  border: none;
  outline: none;
  padding: 8rpx 12rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}
.quality-options {
  display: flex;
  gap: 16rpx;
  flex: 1;
}
.quality-option {
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #6B7280;
  background: #F3F4F6;
  white-space: nowrap;
}
.quality-option.active {
  background: #EFF6FF;
  color: #3B82F6;
  font-weight: 500;
}
.stat-row {
  display: flex;
  gap: 12rpx;
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}
.stat-row text {
  white-space: nowrap;
}

/* ===== 上传按钮 ===== */
.upload-btn-wrapper {
  padding: 0 4rpx;
}
.upload-btn {
  width: 100%;
  height: 96rpx;
  background: #3B82F6;
  color: white;
  border: none;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.2s;
}
.upload-btn:active {
  opacity: 0.8;
}
.upload-btn.disabled {
  background: #D1D5DB;
  color: #9CA3AF;
}
.upload-btn.disabled:active {
  opacity: 1;
}

/* ===== 上传进度（浮层） ===== */
.upload-progress {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #E5E7EB;
  z-index: 10;
}
.progress-text {
  font-size: 28rpx;
  color: #1F2937;
  display: block;
  text-align: center;
  margin-bottom: 16rpx;
}
.progress-bar {
  width: 100%;
  height: 12rpx;
  background: #F3F4F6;
  border-radius: 20rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: #3B82F6;
  border-radius: 20rpx;
  transition: width 0.3s;
}
.progress-cancel {
  text-align: center;
  font-size: 24rpx;
  color: #EF4444;
  margin-top: 16rpx;
}
.progress-cancel:active {
  opacity: 0.6;
}