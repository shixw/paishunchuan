.camera-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #000;
}
camera {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  z-index: 10;
}
.service-btn {
  font-size: 28rpx;
  color: white;
  background: rgba(0,0,0,0.3);
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
}
.status {
  font-size: 28rpx;
  color: white;
}
.status.online { color: #4ade80; }
.status.offline { color: #f87171; }
.status.checking { color: #fbbf24; }
.settings-icon {
  font-size: 44rpx;
  color: white;
}
.shutter-btn {
  position: fixed;
  bottom: 80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.shutter-inner {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: white;
  border: 4rpx solid rgba(0,0,0,0.2);
  transition: transform 0.1s;
}
.shutter-btn:active .shutter-inner {
  transform: scale(0.92);
}
.control-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.25);  /* 更透明 */
  backdrop-filter: blur(15px);
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 30rpx 40rpx 50rpx;
  z-index: 20;
  animation: slideUp 0.3s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  color: white;
}
.panel-title {
  font-size: 32rpx;
  font-weight: 600;
}
.close-icon {
  font-size: 40rpx;
  color: white;
}
.panel-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.15);
  color: white;
  font-size: 30rpx;
}
.item-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.tag-input-wrapper {
  flex: 1;
  margin-left: 20rpx;
}
.tag-input {
  background: rgba(255,255,255,0.2);
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  color: white;
  font-size: 28rpx;
  text-align: right;
}
.item-value {
  color: #fff;
  font-weight: 500;
}

.mask-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: transparent;
  z-index: 15;
}

.control-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.85); 
  backdrop-filter: blur(20px);
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 30rpx 40rpx 50rpx;
  z-index: 20;  /* 高于遮罩层 */
  animation: slideUp 0.3s ease;
}