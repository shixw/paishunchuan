/* ===== 页面基础 ===== */
.camera-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #000;
}
camera {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* ===== 顶部状态栏 ===== */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  z-index: 10;
}
.service-btn {
  font-size: 28rpx;
  color: white;
  background: rgba(0,0,0,0.3);
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
}
.status {
  font-size: 28rpx;
  color: white;
}
.status.online { color: #4ade80; }
.status.offline { color: #f87171; }
.status.checking { color: #fbbf24; }
.settings-icon {
  font-size: 44rpx;
  color: white;
}

/* ===== 底部控制区 ===== */
.bottom-bar {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  padding: 0 40rpx;
}

/* 拍照按钮 */
.shutter-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.shutter-inner {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: white;
  border: 4rpx solid rgba(0,0,0,0.2);
  transition: transform 0.1s;
}
.shutter-btn:active .shutter-inner {
  transform: scale(0.92);
}

.album-btn {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(8px);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  transition: all 0.2s;
  min-width: 110rpx;
}
.album-btn:active {
  opacity: 0.7;
  transform: translateY(-50%) scale(0.95);
}
.album-text {
  font-size: 26rpx;
  color: #1F2937;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* ===== 遮罩层 ===== */
.mask-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: transparent;
  z-index: 15;
}

/* ===== 设置面板 ===== */
.control-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(20px);
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 30rpx 40rpx 50rpx;
  z-index: 20;
  animation: slideUp 0.3s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  color: white;
}
.panel-title {
  font-size: 32rpx;
  font-weight: 600;
}
.close-icon {
  font-size: 40rpx;
  color: white;
}
.panel-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.15);
  color: white;
  font-size: 30rpx;
}
.item-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.item-value {
  color: #fff;
  font-weight: 500;
}