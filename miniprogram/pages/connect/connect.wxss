/* ===== 页面基础 ===== */
page {
  background-color: #FFFDF5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.page-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 品牌区 ===== */
.brand-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  background: transparent;
  padding: 0;
  box-shadow: none;
}
.logo {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  background: transparent;
  padding: 0;
}

.brand-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1F2937;
  margin-top: 32rpx;
  letter-spacing: 2rpx;
}

.brand-subtitle {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 12rpx;
}

.wifi-tip {
  margin-top: 24rpx;
  background: #FEF3E2;
  color: #D97706;
  font-size: 22rpx;
  padding: 16rpx 28rpx;
  border-radius: 16rpx;
  width: 100%;
  text-align: center;
  box-sizing: border-box;
}

/* ===== 输入卡片 ===== */
.input-card {
  width: 100%;
  background: #FFFAF5;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(180, 150, 120, 0.10);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #1F2937;
}

.help-icon {
  width: 40rpx;
  height: 40rpx;
  background: #F0EBE6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #9CA3AF;
  font-weight: 600;
}

.input-wrapper {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  background: #F5F0EB;
  border-radius: 16rpx;
  padding: 0 20rpx;
  border: 2rpx solid #EDE8E3;
  transition: all 0.2s;
  height: 110rpx;
}

.input-wrapper:focus-within {
  border-color: #FCD34D;
  background: #FFFAF5;
}

.input-wrapper.error {
  border-color: #FCA5A5;
  background: #FEF2F2;
}

.input-icon {
  font-size: 32rpx;
  color: #9CA3AF;
  margin-right: 16rpx;
}

.ip-input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #1F2937;
  background: transparent;
  border: none;
  outline: none;
}

.ip-input[disabled] {
  color: #9CA3AF;
}

.input-placeholder {
  color: #D1D5DB;
}

.input-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.action-btn {
  padding: 8rpx;
  font-size: 34rpx;
  color: #D1D5DB;
  cursor: pointer;
}

.error-tip {
  color: #EF4444;
  font-size: 22rpx;
  margin-top: 12rpx;
  padding-left: 4rpx;
}

.input-footer {
  font-size: 20rpx;
  color: #D1D5DB;
  margin-top: 16rpx;
}

/* ===== 按钮组 ===== */
.button-group {
  width: 100%;
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-primary {
  width: 100%;
  height: 100rpx;
  border-radius: 20rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #FCD34D 0%, #34D399 100%);
  transition: all 0.15s ease;
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-primary[disabled] {
  background: #E5E7EB;
}

.btn-primary[disabled] .btn-text {
  color: #9CA3AF;
}

.btn-icon {
  font-size: 28rpx;
  line-height: 1;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.btn-secondary {
  width: 100%;
  height: 100rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid #FCD34D;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.15s ease;
}

.btn-secondary:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-secondary[disabled] {
  border-color: #E5E7EB;
}

.btn-secondary[disabled] .btn-text {
  color: #D1D5DB;
}

.btn-secondary .btn-text {
  color: #F59E0B;
}

/* 自动发现按钮（介于主按钮和次按钮之间） */
.btn-discovery {
  width: 100%;
  height: 100rpx;
  border-radius: 20rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #88D8F7 0%, #A8E6CF 100%);
  transition: all 0.15s ease;
}

.btn-discovery:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-discovery[disabled] {
  background: #E5E7EB;
}

.btn-discovery[disabled] .btn-text {
  color: #9CA3AF;
}

.btn-discovery .btn-text {
  color: #FFFFFF;
}

/* ===== 帮助入口 ===== */
.help-entry {
  width: 100%;
  margin-top: 60rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #FEF3E8, #E8F5E9);
  border-radius: 20rpx;
  cursor: pointer;
  box-sizing: border-box;
}

.help-icon-circle {
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #FCD34D, #34D399);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.help-text {
  flex: 1;
  font-size: 24rpx;
  color: #1F2937;
}

.help-arrow {
  font-size: 32rpx;
  color: #9CA3AF;
  font-weight: 300;
}

/* ===== 底部版本 ===== */
.footer-text {
  font-size: 20rpx;
  color: #D1D5DB;
  margin-top: 80rpx;
  text-align: center;
}