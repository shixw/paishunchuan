.container {
  padding: 30rpx;
  background: #f5f7fb;
  min-height: 100vh;
}
.section {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #1e293b;
  border-left: 8rpx solid #3b82f6;
  padding-left: 20rpx;
}
.step {
  font-size: 30rpx;
  color: #334155;
  margin-bottom: 20rpx;
  line-height: 1.5;
}
.download-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}
.download-btn {
  background: #3b82f6;
  color: white;
  border-radius: 60rpx;
  font-size: 28rpx;
  padding: 16rpx 30rpx;
  margin: 0;
  width: auto;
}
.note {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 16rpx;
}
.qa-item {
  margin-bottom: 24rpx;
}
.qa-q {
  font-weight: 600;
  margin-bottom: 8rpx;
  color: #1e293b;
}
.qa-a {
  color: #475569;
  font-size: 28rpx;
  line-height: 1.4;
}
.info {
  font-size: 28rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}